# --- Database ---
# Local Postgres, e.g. via `docker compose up -d` (see README) or a hosted instance (Neon, Supabase, RDS).
DATABASE_URL="postgresql://placement:placement@localhost:5432/placement_fm?schema=public"

# --- App ---
# Public base URL, used to build magic links and curator signup links in emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth ---
# Random 32+ char secret used to sign curator/admin session JWTs and magic-link tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Bootstrap admin credentials (used by prisma/seed.ts to create the first admin user).
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="change-me-now"

# --- Stripe ---
# Platform account keys (test mode to start). Connect must be enabled with Express accounts.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
# From the Stripe CLI (`stripe listen`) or the dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
# Platform fee, as a decimal (0.20 = 20%), per spec section 4.
PLATFORM_FEE_PERCENT="0.20"

# --- Resend (transactional email) ---
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="Outroll <notifications@outroll.me>"

# --- Cron ---
# Shared secret required in the Authorization header when Vercel Cron (or any scheduler)
# calls /api/cron/deadlines. Generate with: openssl rand -hex 24
CRON_SECRET="replace-with-a-long-random-string"

# --- Social account verification (src/lib/socialAuth/) ---
# Required for curators to connect + verify Instagram, Facebook Reels, TikTok, YouTube Shorts,
# or Snapchat before listing on them. See CLAUDE.md for the setup checklist per provider —
# Google and Snapchat are self-serve, Meta and TikTok require an App Review approval that isn't
# instant.
GOOGLE_CLIENT_ID="replace_me"
GOOGLE_CLIENT_SECRET="replace_me"
TIKTOK_CLIENT_KEY="replace_me"
TIKTOK_CLIENT_SECRET="replace_me"
# Instagram uses its own separate app/credentials via "Instagram API with Instagram Login" —
# not the same app as META_CLIENT_ID below, which now only covers Facebook Reels.
INSTAGRAM_CLIENT_ID="replace_me"
INSTAGRAM_CLIENT_SECRET="replace_me"
META_CLIENT_ID="replace_me"
META_CLIENT_SECRET="replace_me"
# Snapchat Login Kit — proves account ownership only, no follower-count API. Self-serve, no
# App Review wait; register at the Snap Developer Portal.
SNAPCHAT_CLIENT_ID="replace_me"
SNAPCHAT_CLIENT_SECRET="replace_me"
